          },
          {
            "key": "x-rapidapi-host",
            "value": "pricepulse-e-commerce-price-stock-intelligence-api.p.rapidapi.com",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"urls\": [\n    \"https://www.etsy.com/listing/1776489744/ultimate-annual-budget-spreadsheet\",\n    \"https://allbirds.com/products/mens-tree-runners\"\n  ]\n}"
